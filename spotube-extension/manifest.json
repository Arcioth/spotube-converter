{
  "manifest_version": 3,
  "name": "Spotube: YouTube Music Playlist Creator",
  "version": "2.0",
  "description": "Securely migrate Spotify CSV playlists or AI-generated lists to YouTube Music.",
  "action": {
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://music.youtube.com/*"
  ]
}
